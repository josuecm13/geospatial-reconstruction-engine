# Copy this file to .env and adjust if needed.

# Points at the docker-compose "db" service (postgis/postgis). The host port is
# deliberately far from 5432/5433 so it won't collide with another local Postgres.
DATABASE_URL=postgresql+psycopg://geodb:geodb@localhost:55432/geodb

# Port for `uvicorn app.main:app --port "$APP_PORT"`, chosen to avoid common dev
# server ports (3000/5000/8000/8080/8888).
APP_PORT=58000
