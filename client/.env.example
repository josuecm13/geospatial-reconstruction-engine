# Copy to client/.env to change the dev server's port. The API port comes from APP_PORT in
# server/.env, so the two stay in step.
CLIENT_PORT=55173
# Forward API calls somewhere other than localhost:$APP_PORT.
# API_TARGET=http://localhost:58000
# Which import area the landing page features (an id from /import-areas). Unset: the most recent completed one.
# VITE_FEATURED_AREA_ID=
